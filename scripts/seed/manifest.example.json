  "posts": [
    { "key": "marta-lisbon-p1", "authorKey": "marta-lisbon", "type": "video", "text": "A city works if an eight-year-old can cross it alone.", "context": "Morning school run, Arroios", "categories": ["values", "focus"], "mediaQuery": "children crossing street" },
    { "key": "marta-lisbon-p2", "authorKey": "marta-lisbon", "type": "image", "text": "Every parking space is a small apartment we decided to give to a car.", "categories": ["values"], "mediaQuery": "parked cars street" },
    { "key": "marta-lisbon-p3", "authorKey": "marta-lisbon", "type": "video", "text": "Trams are slower than cars and I would still pick them every single time.", "categories": ["soul", "culture"], "mediaQuery": "tram city" },
    { "key": "marta-lisbon-p4", "authorKey": "marta-lisbon", "type": "video", "text": "Benches are a political decision. Count them on your street and you'll see who a city is for.", "categories": ["values"], "mediaQuery": "park bench city" },
    { "key": "marta-lisbon-p5", "authorKey": "marta-lisbon", "type": "image", "text": "Rent control treats the symptom. We still need to build way more homes.", "categories": ["values", "mind"], "mediaQuery": "apartment construction" },

    { "key": "dev-okafor-p1", "authorKey": "dev-okafor", "type": "video", "text": "Motivation is overrated. Build the habit and stop checking how you feel about it.", "context": "5:40am, empty gym", "categories": ["focus", "mind"], "mediaQuery": "gym morning workout" },
    { "key": "dev-okafor-p2", "authorKey": "dev-okafor", "type": "image", "text": "If your startup needs a pitch deck to explain why it matters, it probably doesn't.", "categories": ["mind"], "mediaQuery": "laptop office desk" },
    { "key": "dev-okafor-p3", "authorKey": "dev-okafor", "type": "video", "text": "Work-life balance is a luxury you earn after the work pays off, not before.", "categories": ["focus", "values"], "mediaQuery": "city skyline night office" },
    { "key": "dev-okafor-p4", "authorKey": "dev-okafor", "type": "video", "text": "Losing money on a bet you understood beats making money on one you didn't.", "categories": ["mind"], "mediaQuery": "stock chart screen" },
    { "key": "dev-okafor-p5", "authorKey": "dev-okafor", "type": "image", "text": "Nobody remembers who played it safe.", "context": "Lagos traffic, somehow inspiring", "categories": ["soul", "focus"], "mediaQuery": "busy traffic city" },

    { "key": "ines-kyoto-p1", "authorKey": "ines-kyoto", "type": "video", "text": "A bowl you made badly by hand is worth more than ten perfect ones from a factory.", "context": "Wheel day at the studio", "categories": ["culture", "focus"], "mediaQuery": "pottery wheel hands" },
    { "key": "ines-kyoto-p2", "authorKey": "ines-kyoto", "type": "image", "text": "Reading one book slowly all year beats skimming fifty.", "categories": ["mind", "culture"], "mediaQuery": "old book reading" },
    { "key": "ines-kyoto-p3", "authorKey": "ines-kyoto", "type": "video", "text": "Some things should stay hard to get to. That's what keeps them worth the trip.", "categories": ["culture", "values"], "mediaQuery": "mountain temple path" },
    { "key": "ines-kyoto-p4", "authorKey": "ines-kyoto", "type": "video", "text": "Boredom is where every good idea I've had started. Stop curing it with your phone.", "categories": ["mind", "soul"], "mediaQuery": "rain window quiet" },
    { "key": "ines-kyoto-p5", "authorKey": "ines-kyoto", "type": "image", "text": "Translations should sound foreign. Smoothing a poem into your own language erases it.", "categories": ["culture", "mind"], "mediaQuery": "calligraphy ink brush" }
  ],
  "comments": [
    { "key": "marta-lisbon-p1-c1", "postKey": "marta-lisbon-p1", "authorKey": "sam-reyes", "text": "Night shift nurse here — the kids I see after car accidents would agree with this." },
    { "key": "marta-lisbon-p1-c2", "postKey": "marta-lisbon-p1", "authorKey": "henrik-berg", "text": "Nice idea until you need to get across town with a trailer and two kayaks." },
    { "key": "dev-okafor-p3-c1", "postKey": "dev-okafor-p3", "authorKey": "ines-kyoto", "text": "And when exactly does it pay off? The goalpost moves every year." },
    { "key": "dev-okafor-p3-c2", "postKey": "dev-okafor-p3", "authorKey": "henrik-berg", "text": "Worked forty years. The ones who waited for balance mostly never found it." },
    { "key": "ines-kyoto-p4-c1", "postKey": "ines-kyoto-p4", "authorKey": "dev-okafor", "text": "Counterpoint: my best ideas came from shipping and seeing what broke." }
  ]
