# Runs with no database at all, seeded from the sample people and posts.
STORE=memory
DEV_AUTH=true
PORT=4000

# Point at a hosted Supabase project instead. DEV_AUTH must be off:
# with it on, anyone could act as any user by sending `Bearer dev:<id>`.
# STORE=supabase
# DEV_AUTH=false
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never ship to a client>

# Set this on any real deployment (most hosts set it for you). With it set,
# assertConfig() refuses to boot on STORE=memory or without GEMINI_API_KEY —
# both would otherwise silently degrade a real beta (lost data on restart,
# unmoderated posts). Leave unset for local dev.
# NODE_ENV=production

# Spec §8: scores every post (images and video) on the five grids. Without this the
# server falls back to the deterministic stub (fine for local dev, not fit for real users).
# GEMINI_API_KEY=<key from aistudio.google.com/apikey>
# SCORER_MODEL=gemini-3.5-flash-lite

# Browser origins allowed to call this API cross-origin (comma-separated).
# The native app itself isn't subject to CORS. The pnyx-waitlist site's signup
# form (POST /waitlist) is a browser client, so its address must be listed.
# Left unset, no cross-origin browser access is allowed at all.
# ALLOWED_ORIGINS=https://pnyx-waitlist.onrender.com

# Seed pipeline (scripts/seed/, see its README). Dev-only — not read by the server.
# PEXELS_API_KEY=<free key from pexels.com/api — stock photos/videos for seed posts>
# SEED_MODEL=<Gemini model that writes seed personas/posts; defaults to SCORER_MODEL>
# SEED_DATA_DIR=<where the manifest and media live; defaults to ./seed-data>
# FFMPEG_PATH=<ffmpeg binary for mixing music into seed videos; defaults to ffmpeg on PATH>
